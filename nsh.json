{
  "name": "NSH Music",
  "id": "com.richerfu.nshmusic",
  "version": "0.1.0",
  "icon": {
    "macos": "assets/app-icon-macos.png",
    "linux": "assets/app-icon-linux.png",
    "windows": "assets/app-icon-windows.png",
    "ios": "assets/app-icon.png",
    "web": "assets/app-icon.png",
    "android": {
      "foreground": "assets/app-icon-android-foreground.png",
      "background": "assets/app-icon-android-background.png",
      "monochrome": "assets/app-icon-android-monochrome.png"
    }
  },
  "appearance": "system",
  "theme": "theme.json",
  "rust": ".",
  "root": "App",
  "singleInstance": true,
  "schemes": ["nsh-music", "mygo-music"],
  "capabilities": {
    "audio": true,
    "windows": true,
    "application": true,
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "openUrl": true,
    "fs": {
      "read": ["${dataDir}"]
    },
    "network": {
      "hosts": ["*"]
    },
    "webview": {
      "hosts": ["*"]
    }
  },
  "ios": {
    "infoPlist": {
      "UIBackgroundModes": ["audio"]
    }
  },
  "android": {
    "usesCleartextTraffic": true,
    "permissions": [
      "INTERNET",
      "FOREGROUND_SERVICE",
      "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
      "POST_NOTIFICATIONS",
      "WAKE_LOCK"
    ]
  },
  "harmonyos": {
    "querySchemes": ["https", "http"],
    "permissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "Stream music, fetch album artwork, and run music plugins.",
        "when": "inuse"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "Continue audio playback in the background.",
        "when": "always"
      }
    ]
  }
}
