{
  "name": "NSH Music",
  "id": "com.richerfu.nshmusic",
  "version": "0.1.0",
  "icon": "assets/app-icon.png",
  "appearance": "system",
  "theme": "theme.json",
  "rust": ".",
  "root": "App",
  "schemes": ["nsh-music", "mygo-music"],
  "capabilities": {
    "audio": true,
    "windows": true,
    "application": true,
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "openUrl": true,
    "fs": {
      "read": ["${dataDir}"]
    },
    "network": {
      "hosts": ["*"]
    },
    "webview": {
      "hosts": ["*"]
    }
  },
  "harmonyos": {
    "querySchemes": ["https", "http"],
    "permissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "Stream music, fetch album artwork, and run music plugins.",
        "when": "inuse"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "Continue audio playback in the background.",
        "when": "always"
      }
    ]
  }
}
